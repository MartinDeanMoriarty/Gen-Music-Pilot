{
    "comfy_url": "http://127.0.0.1:8188",
    "comfy": {
        "request_timeout": 10.0,
        "job_timeout": 600.0,
        "poll_interval": 1.5
    },
    "assets_dir": "assets",
    "music": {
        "min_length_seconds": 120,
        "max_length_seconds": 200
    },
    "library_dir": "media",
    "buffer_target_seconds": 420,
    "mode": "generative",
    "local_audio": true,
    "retention": {
        "max_age_minutes": 60,
        "max_tracks": 40
    },
    "station": {
        "name": "Gen-Music-Pilot",
        "persona_file": "config/persona.md"
    },
    "ollama": {
        "url": "http://127.0.0.1:11434",
        "model": "qwen3.5:latest"
    },
    "weather": {
        "apikey": "",
        "location": "Köln",
        "ttl_minutes": 60
    },
    "stream": {
        "enabled": false,
        "backend": "pyfanout",
        "bind": "0.0.0.0:8080",
        "codec": "mp3",
        "bitrate_kbps": 128,
        "icecast": {
            "host": "127.0.0.1",
            "port": 8000,
            "mount": "/live",
            "source_password": "change-me"
        }
    },
    "web": {
        "host": "127.0.0.1",
        "port": 7860,
        "share": false,
        "auto_start": false
    },
    "workflows": {
        "moderation": "workflows/Radio_TTS.json",
        "story": "workflows/Radio_Story.json",
        "music": "workflows/Radio_Music+Lyrics.json"
    },
    "user_music_dirs": [
        {
            "name": "My Collection",
            "path": "user_music/collection"
        }
    ]
}
